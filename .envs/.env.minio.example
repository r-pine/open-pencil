# MinIO root (admin) — do not share with the team
MINIO_ROOT_USER=CHANGE_ME_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Public endpoint / proxy
VIRTUAL_HOST=pencil-s3.rpine.xyz
VIRTUAL_PORT=9000
LETSENCRYPT_HOST=pencil-s3.rpine.xyz
LETSENCRYPT_EMAIL=todd.develop@gmail.com

# MinIO public URL (path-style API behind nginx-proxy)
MINIO_SERVER_URL=https://pencil-s3.rpine.xyz
MINIO_BROWSER_REDIRECT_URL=https://pencil-s3.rpine.xyz

# Bucket + team credentials (share these with the team)
MINIO_BUCKET=open-pencil
MINIO_REGION=us-east-1
MINIO_TEAM_ACCESS_KEY=CHANGE_ME_TEAM_ACCESS_KEY
MINIO_TEAM_SECRET_KEY=CHANGE_ME_TEAM_SECRET_KEY

# Paths used by sync / seed scripts
PENCIL_DESIGN_DIR=/root/aska.chat/design
PENCIL_S3_ENDPOINT=https://pencil-s3.rpine.xyz
MINIO_API_CORS_ALLOW_ORIGIN=https://pencil.rpine.xyz,https://app.openpencil.dev,http://localhost:5173,http://127.0.0.1:5173
